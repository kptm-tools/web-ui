{
  "$schema": "https://json.schemastore.org/eslintrc",
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    // If you're using TypeScript, uncomment the following line:
    // "plugin:@typescript-eslint/recommended",
    // If you're using Vue 3, uncomment the following line:
    // "plugin:vue/vue3-recommended",
    // If you're using Vue 2, uncomment the following line:
    // "plugin:vue/recommended",
    "plugin:prettier/recommended" // Make sure this is the LAST extension
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    // If you're using TypeScript, uncomment the following line:
    // "parser": "@typescript-eslint/parser",
    "sourceType": "module"
  },
  "plugins": [
    // If you're using TypeScript, uncomment the following line:
    // "@typescript-eslint",
    // If you're using Vue, uncomment the following line:
    // "vue",
    "prettier"
  ],
  "rules": {
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "comma-dangle": ["error", "never"],
    "indent": ["error", 2, { "SwitchCase": 1 }],
    "no-tabs": "error",
    "space-before-blocks": "error",
    "object-curly-spacing": ["error", "always"],
    "arrow-parens": ["error", "avoid"],
    // If you're using Vue, uncomment the following lines:
    // "vue/script-indent": [ "error", 2, { "baseIndent": 1 } ],
    // "vue/html-indent": [ "error", 2 ],
    "linebreak-style": ["error", "unix"],
    "max-len": ["warn", { "code": 100, "ignoreComments": true, "ignoreUrls": true }]
    // Add any other ESLint rules you want to enforce beyond Prettier's formatting
    // For example:
    // "no-unused-vars": "warn",
    // "no-console": "warn"
  },
  "overrides": [
    // If you're using Vue, uncomment the following block:
    // {
    //   "files": ["*.vue"],
    //   "rules": {
    //     "indent": "off" // Disable the default indent rule for .vue files as vue/script-indent handles it
    //   }
    // }
  ]
}
