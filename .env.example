# Runtime Configuration for Local Development
# Copy this file to .env and modify values as needed

# Backend API base URL
API_BASE_URL=http://localhost:8000

# WebSocket base URL
WS_BASE_URL=ws://localhost:8000/api/core

# Feature Flags
# Set to 'true' to enable Cybersecurity Framework Assessment (Audits) module
# Set to 'false' to disable access to audits routes
FEATURE_COMPLIANCE_FRAMEWORK_ENABLED=true

# Development flags (Vite-specific, used at build time)
VITE_BYPASS_AUTH=false
VITE_PRISM_MODE=false
