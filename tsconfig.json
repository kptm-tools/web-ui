{
  "extends": "./.quasar/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "types": ["vite/client", "vitest", "vitest/globals"],
    "paths": {
      "src/*": ["./src/*"],
      "boot/*": ["./src/boot/*"],
      "stores/*": ["./src/stores/*"]
    }
  },
  "exclude": [
    "./dist",
    "./.quasar",
    "./node_modules",
    "./src-capacitor",
    "./src-cordova",
    "./quasar.config.*.temporary.compiled*"
  ]
}
