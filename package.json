{
  "name": "web-ui",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Quasar App",
  "author": "Diego Carhuavilca <diego.carhuavilca@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\" --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "test:unit:ci": "vitest run --coverage",
    "test:unit:ui": "vitest --ui --coverage"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "apexcharts": "^4.5.0",
    "axios": "^1.2.1",
    "chart.js": "^4.4.8",
    "chartjs-plugin-dragdata": "^2.3.1",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "socket.io-client": "^4.8.1",
    "vue": "^3.4.18",
    "vue-chartjs": "^5.3.2",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.0.12",
    "vue3-apexcharts": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@quasar/app-vite": "^2.1.0",
    "@quasar/quasar-app-extension-testing-unit-vitest": "^1.2.3",
    "@types/node": "^20.5.9",
    "@vitest/coverage-istanbul": "3.1.3",
    "@vitest/ui": "^3.1.2",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "~5.5.3",
    "vite-plugin-checker": "^0.8.0",
    "vitest": "^3.1.2",
    "vue-tsc": "^2.0.29"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
