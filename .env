# Development environment variables (used for local development)
# For production/Docker deployments, these are overridden by runtime config

# API endpoint for backend services
API_BASE_URL=http://localhost:8000

# WebSocket endpoint for real-time features
WS_BASE_URL=ws://localhost:8000/api/core

# Note: When running in Docker/Kubernetes, these values are replaced
# by runtime configuration via environment variables:
# - API_BASE_URL (e.g., http://api.kptm.local)
# - WS_BASE_URL (e.g., ws://api.kptm.local/api/core)

# QA Testing configuration
# Set to 'true' to bypass authentication for QA testing with Prism mock server
# WARNING: Only use this in development/QA environments, never in production!
VITE_BYPASS_AUTH=true

# Set to 'true' to enable Prism-compatible API paths (strips gateway prefixes)
# This allows testing with Prism mock server without the gateway layer
VITE_PRISM_MODE=false

# Feature Flags
# Set to 'true' to allow access to the AUDITS App
VITE_FEATURE_COMPLIANCE_FRAMEWORK_ENABLED=false
